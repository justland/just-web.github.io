{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"files": {
		"includes": [
			"!**/node_modules",
			"!**/.next",
			"!**/.astro",
			"!**/.docusaurus",
			"!**/build",
			"!**/dist",
			"!**/.turbo",
			"!pnpm-lock.yaml",
			"!skills-lock.json",
			"!**/*.astro",
			"!**/*.svg"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"noUnknownAtRules": "off"
					}
				}
			}
		},
		{
			"includes": ["astro-react/**", "astro-solid/**", "docusaurus/**", "nextjs/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["docusaurus/**"],
			"javascript": {
				"jsxRuntime": "reactClassic"
			}
		}
	]
}
