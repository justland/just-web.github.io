{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
		},
		"build:doc": {
			"dependsOn": ["^build"],
			"outputs": ["build/**"]
		},
		"clean": {
			"cache": false
		},
		"nuke": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["build"]
		}
	}
}
