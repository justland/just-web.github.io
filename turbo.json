{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"outputs": [
				"dist/**",
				"build/**",
				".next/**",
				"!.next/cache/**"
			]
		},
		"clean": {
			"cache": false
		},
		"nuke": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": [
				"^build"
			]
		}
	}
}
