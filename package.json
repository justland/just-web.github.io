{
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"ar": "pnpm --filter ./astro-react",
		"as": "pnpm --filter ./astro-solid",
		"build": "turbo build",
		"clean": "turbo run clean",
		"d": "pnpm --filter ./docusaurus",
		"format": "biome format --write",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"n": "pnpm --filter ./nextjs",
		"nuke:local": "node -e \"fs.rmSync('node_modules',{recursive:true,force:true})\"",
		"nuke": "turbo run nuke && pnpm nuke:local",
		"prepare": "husky",
		"verify": "pnpm lint && turbo build lint"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.10.12"
	}
}
